{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vite-hono/landing", "dev"],
      "port": 5200
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vite-hono/web", "dev"],
      "port": 5100,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vite-hono/server", "dev"],
      "port": 3000
    },
    {
      "name": "mcp",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vite-hono/mcp", "dev"],
      "port": 5300
    },
    {
      "name": "pocketbase",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "docker-compose.dev.yml", "up"],
      "port": 9000
    }
  ]
}
