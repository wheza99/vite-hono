# ─── Subdomain routing ───────────────────────────────────────────────────
# yourdomain.com         → Astro landing (static files in /srv/landing)
# app.yourdomain.com     → React web app (static files in /srv/web)
# app.yourdomain.com/api → Hono server
# app.yourdomain.com/pb  → PocketBase (proxied through the server origin)
#
# `DOMAIN` defaults to `localhost`. To run all three hostnames locally,
# point both `localhost` and `app.localhost` at 127.0.0.1 and visit
# http://localhost (landing) / http://app.localhost (web app).

# Apex domain → marketing landing site (Astro static export).
{$DOMAIN:localhost} {
	encode gzip

	root * /srv/landing
	try_files {path} /index.html
	file_server
}

# App subdomain → React dashboard, with API + PocketBase reverse-proxied.
app.{$DOMAIN:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy server:3000
	}

	handle_path /pb/* {
		reverse_proxy pocketbase:8090
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
