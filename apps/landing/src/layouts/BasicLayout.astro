---
import BaseHead from "@/components/BaseHead.astro";
import { THEME } from "@/styles/theme";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Chromeless layout (head only). Theme vars are still injected so any
// standalone page stays on-brand. Use for raw embeds or bare article views.
const themeVars = `
:root {
  --primary: ${THEME.accent};
  --primary-foreground: ${THEME.accentForeground};
  --accent-text: ${THEME.accent};
  --accent-hover: ${THEME.accentHover};
  --font-display: "${THEME.displayFont}", ui-sans-serif, system-ui, sans-serif;
}
.dark {
  --primary: ${THEME.accent};
  --primary-foreground: ${THEME.accentForeground};
}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <style is:inline set:html={themeVars} />
  </head>
  <body class="bg-background text-foreground min-h-svh antialiased">
    <slot />
  </body>
</html>
