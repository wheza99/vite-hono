---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/sections/navbar";
import { Footer } from "@/components/sections/footer";
import { THEME } from "@/styles/theme";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

/**
 * THEME → CSS variable injection.
 *
 * This is the KEY rebranding mechanism. The values in `src/styles/theme.ts`
 * are emitted as CSS custom properties on :root here, overriding the oklch
 * fallbacks in global.css. Change one value in theme.ts (e.g. the accent
 * color or the startup name) and the entire site rebrands — navbar, footer,
 * buttons, hero headline, the lot.
 *
 * Emitted inline + before the stylesheet cascade so it wins over the
 * defaults in global.css.
 */
const themeVars = `
:root {
  --primary: ${THEME.accent};
  --primary-foreground: ${THEME.accentForeground};
  --accent-text: ${THEME.accent};
  --accent-hover: ${THEME.accentHover};
  --font-display: "${THEME.displayFont}", ui-sans-serif, system-ui, sans-serif;
}
.dark {
  --primary: ${THEME.accent};
  --primary-foreground: ${THEME.accentForeground};
}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <style is:inline set:html={themeVars} />
  </head>
  <body class="bg-background text-foreground min-h-svh antialiased">
    <Navbar client:load />
    <main><slot /></main>
    <Footer client:load />
  </body>
</html>
