---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/sections/navbar";
import { Footer } from "@/components/sections/footer";
import { THEME } from "@/styles/theme";

// Standalone error page (no DefaultLayout) so the 404 stays clean and
// on-brand. THEME → CSS variables are injected just like DefaultLayout.
const themeVars = `
:root {
  --primary: ${THEME.accent};
  --primary-foreground: ${THEME.accentForeground};
  --accent-text: ${THEME.accent};
  --accent-hover: ${THEME.accentHover};
  --font-display: "${THEME.displayFont}", ui-sans-serif, system-ui, sans-serif;
}
.dark {
  --primary: ${THEME.accent};
  --primary-foreground: ${THEME.accentForeground};
}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`404 — ${THEME.name}`} description="Page not found." />
    <style is:inline set:html={themeVars} />
  </head>
  <body class="bg-background text-foreground min-h-svh antialiased">
    <Navbar client:load />
    <main class="bg-dot-grid relative overflow-hidden">
      {/* soft accent spotlight over the dot grid */}
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] bg-[radial-gradient(55%_100%_at_50%_0%,color-mix(in_oklch,var(--primary)_16%,transparent),transparent)]"
      >
      </div>

      <section
        class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-6 py-24 text-center"
      >
        <p
          class="text-accent text-balance text-[7rem] font-bold leading-none tracking-tight md:text-[12rem]"
        >
          404
        </p>
        <h1
          class="mt-6 text-balance text-2xl font-semibold tracking-tight md:text-3xl"
        >
          This page doesn&rsquo;t exist or has moved.
        </h1>
        <p class="mt-4 max-w-md text-pretty text-muted-foreground">
          The page you&rsquo;re looking for may have been renamed or is no longer
          available.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="border-border bg-background text-foreground hover:bg-muted inline-flex h-11 items-center justify-center rounded-lg border px-6 text-sm font-medium transition-colors"
          >
            Go home
          </a>
          <a
            href={THEME.appUrl}
            class="bg-primary text-primary-foreground hover:bg-[var(--accent-hover)] inline-flex h-11 items-center justify-center rounded-lg px-6 text-sm font-medium transition-colors"
          >
            Get Started
          </a>
        </div>
      </section>
    </main>
    <Footer client:load />
  </body>
</html>
