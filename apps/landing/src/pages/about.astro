---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { THEME } from "@/styles/theme";
import AboutHero from "@/components/sections/about-hero";
import CtaSection from "@/components/sections/cta-section";
---

{/* TEMPLATE: All copy below is placeholder. Replace the mission statement
    and tech-stack descriptions with your real company story before launch. */}
<DefaultLayout
  title={`About — ${THEME.name}`}
  description={`Learn about ${THEME.name} — our mission, our team, and the technology we build on.`}
>
  {/* ════════════════════ Section 1: About Hero ════════════════════ */}
  <AboutHero client:load />

  {/* ════════════════════ Section 2: Vision / Mission ════════════════════ */}
  {/* TEMPLATE: Replace this placeholder mission statement. */}
  <section class="border-b">
    <div class="mx-auto max-w-3xl px-6 py-20 md:py-28">
      <span class="section-label">Our mission</span>
      <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight md:text-4xl">
        Removing the friction between idea and product.
      </h2>
      <div class="mt-6 space-y-5 text-pretty text-lg leading-relaxed text-muted-foreground">
        <p>
          We believe [problem] shouldn&rsquo;t be hard. Too many teams waste
          time on boilerplate instead of building what matters.
        </p>
        <p>
          Our mission is to remove the friction &mdash; so you can focus on
          your product, not your plumbing.
        </p>
      </div>
    </div>
  </section>

  {/* ════════════════════ Section 3: Tech Stack ════════════════════ */}
  <section class="border-b">
    <div class="mx-auto max-w-7xl px-6 py-20 md:py-28">
      <div class="max-w-2xl">
        <span class="section-label">Built with</span>
        <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight md:text-4xl">
          A modern, production-tested stack.
        </h2>
        <p class="text-muted-foreground mt-4 text-pretty text-lg">
          We stand on the shoulders of great open-source tools.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="bg-card glow-card rounded-2xl p-6 ring-1 ring-foreground/10">
          <h3 class="text-lg font-semibold tracking-tight">Vite</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Lightning-fast dev server and build tooling.
          </p>
        </div>
        <div class="bg-card glow-card rounded-2xl p-6 ring-1 ring-foreground/10">
          <h3 class="text-lg font-semibold tracking-tight">Hono</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Ultrafast, lightweight web framework for the API.
          </p>
        </div>
        <div class="bg-card glow-card rounded-2xl p-6 ring-1 ring-foreground/10">
          <h3 class="text-lg font-semibold tracking-tight">PocketBase</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Open-source backend with auth, DB, and realtime.
          </p>
        </div>
        <div class="bg-card glow-card rounded-2xl p-6 ring-1 ring-foreground/10">
          <h3 class="text-lg font-semibold tracking-tight">React</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Component-driven UI for the dashboard and app.
          </p>
        </div>
        <div class="bg-card glow-card rounded-2xl p-6 ring-1 ring-foreground/10">
          <h3 class="text-lg font-semibold tracking-tight">Tailwind</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Utility-first styling that ships fast and stays consistent.
          </p>
        </div>
        <div class="bg-card glow-card rounded-2xl p-6 ring-1 ring-foreground/10">
          <h3 class="text-lg font-semibold tracking-tight">Astro</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            Content-first, island-architecture framework for this site.
          </p>
        </div>
      </div>

      <p class="text-muted-foreground mt-10 text-sm">
        Part of the
        <a
          href="https://pabrikstartup.id"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline"
          >Pabrik Startup</a
        > ecosystem.
      </p>
    </div>
  </section>

  {/* ════════════════════ Section 4: CTA ════════════════════ */}
  <CtaSection
    title="Join us"
    subtitle="Start building with [Startup Name] today — free for 14 days."
    buttonLabel="Get Started"
  />
</DefaultLayout>
