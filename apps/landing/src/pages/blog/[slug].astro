---
import { getCollection, render } from "astro:content";

import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { THEME } from "@/styles/theme";
import BlogPostLayout from "@/components/sections/blog-post-layout";
import { sortByDateDesc, toPostMeta } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const meta = toPostMeta(post);

// Related posts: newest-first, excluding the current one (max 3).
const related = sortByDateDesc(await getCollection("blog"))
  .filter((entry) => entry.id !== post.id)
  .slice(0, 3)
  .map(toPostMeta);
---

<DefaultLayout
  title={`${meta.title} — ${THEME.name}`}
  description={meta.description ?? `${THEME.name} blog`}
>
  {/* ════════════════════ Article header (React island) ════════════════════ */}
  <article>
    <BlogPostLayout post={meta} client:load />

    {/* ════════════════════ Article body (server-rendered MDX) ════════════════════ */}
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div
        class="prose prose-lg max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-headings:font-display prose-a:font-medium prose-img:rounded-lg"
      >
        <Content />
      </div>
    </div>
  </article>

  {/* ════════════════════ Related posts ════════════════════ */}
  {
    related.length > 0 && (
      <section class="border-border border-t bg-muted/30">
        <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
          <h2 class="text-balance text-2xl font-semibold tracking-tight md:text-3xl">
            Keep reading
          </h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((entry) => (
              <a
                href={`/blog/${entry.slug}`}
                class="glow-card bg-card group flex flex-col rounded-2xl p-6 ring-1 ring-foreground/10"
              >
                {entry.tags.length > 0 && (
                  <span class="bg-primary/10 text-primary inline-flex w-fit rounded-full px-2.5 py-0.5 text-xs font-medium">
                    {entry.tags[0]}
                  </span>
                )}
                <h3 class="mt-3 text-lg font-semibold tracking-tight transition-colors group-hover:text-primary">
                  {entry.title}
                </h3>
                <span class="text-muted-foreground mt-4 text-xs">
                  {entry.dateFormatted}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</DefaultLayout>
