---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { THEME } from "@/styles/theme";
import ShowcasePreview from "@/components/sections/showcase-preview";
import CtaSection from "@/components/sections/cta-section";
---

<DefaultLayout
  title={`Showcase — ${THEME.name}`}
  description={`See what's possible with ${THEME.name}. A gallery of example projects built on the template.`}
>
  {/* ════════════════════ Section 1: Hero ════════════════════ */}
  <section class="bg-dot-grid relative overflow-hidden border-b">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] bg-[radial-gradient(55%_100%_at_50%_0%,color-mix(in_oklch,var(--primary)_16%,transparent),transparent)]"
    >
    </div>

    <div
      class="mx-auto flex max-w-4xl flex-col items-center px-6 pt-24 pb-16 text-center md:pt-32 md:pb-20"
    >
      <span class="section-label">Showcase</span>
      <h1
        class="text-accent mt-4 text-balance text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
      >
        Built with this template.
      </h1>
      <p class="mt-6 max-w-2xl text-pretty text-lg text-muted-foreground">
        A glimpse of what&rsquo;s possible. Replace these with your real
        screenshots and case studies.
      </p>
    </div>
  </section>

  {/* ════════════════════ Section 2: Gallery Grid ════════════════════ */}
  {/* TEMPLATE: Replace with real screenshots */}
  <ShowcasePreview />

  {/* ════════════════════ Section 3: CTA ════════════════════ */}
  <CtaSection
    title="Start building"
    subtitle="Use this template to launch your next project today."
  />
</DefaultLayout>
