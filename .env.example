# ── Port Slot: 00 (template) | Server=3000 | PB dev=9000 | Web=5100 | Landing=5200 | MCP=5300 | See ./PORT_REGISTRY.md ──

# PocketBase superuser (create via: pocketbase superuser upsert <email> <password>)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme123

# Whop billing (optional — billing routes return 503 when unset)
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_ACCESS_PASS_ID=
WHOP_WEBHOOK_SECRET=

# ── Auth: Cloudflare Turnstile + Google OAuth2 (all optional) ──
# Turnstile: public site key is a WEB build arg (baked into the bundle at build
# time), secret is backend-only. Leave both empty to disable the bot check.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google OAuth2: consumed server-side by PocketBase (synced onto the users
# collection on boot by pb_hooks/google-oauth.pb.js). Register the redirect URI
# https://<domain>/pb/api/oauth2-redirect in Google Cloud Console. The VITE_
# prefix is just where they live in this shared .env — PocketBase reads them as
# GOOGLE_CLIENT_ID/SECRET (see docker-compose.yml).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Allowed CORS origins for /api/* (comma-separated). In production the web
# container proxies /api same-origin, so this is mainly for local dev.
CORS_ORIGIN=http://localhost:5100
