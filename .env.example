# ── Port Slot: 06 | App=3006 | PB=9006 | See ../PORT_REGISTRY.md ──
# Domain used by Caddy in production (docker compose up)
DOMAIN=localhost

# PocketBase superuser (create via: pocketbase superuser upsert <email> <password>)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme123

# Whop billing (optional — billing routes return 503 when unset)
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_ACCESS_PASS_ID=
WHOP_WEBHOOK_SECRET=

# Allowed CORS origins for /api/* (comma-separated)
CORS_ORIGIN=http://localhost:5173
