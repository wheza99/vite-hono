# ── Port Slot: 00 (template) | Server=3000 | PB dev=9000 | Web=5100 | Landing=5200 | MCP=5300 | See ./PORT_REGISTRY.md ──

# PocketBase superuser (create via: pocketbase superuser upsert <email> <password>)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=changeme123

# Whop billing (optional — billing routes return 503 when unset)
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_ACCESS_PASS_ID=
WHOP_WEBHOOK_SECRET=

# Allowed CORS origins for /api/* (comma-separated). In production the web
# container proxies /api same-origin, so this is mainly for local dev.
CORS_ORIGIN=http://localhost:5100
